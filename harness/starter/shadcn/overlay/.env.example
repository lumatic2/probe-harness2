# 복사해서 쓴다: cp .env.example .env   (.env 는 커밋하지 않는다 — 서버 프로세스만 읽는다)

# AI 어댑터(/api/assist · /api/chat · /api/transcribe) — 없으면 모의 응답. 과제 환경이 주는 값을 그대로 넣는다(값은 여기 .env 에만, 코드·문서·로그에 쓰지 않는다).
# 넣고 서버를 다시 켜면 AI 대화 패널 맨 아래가 「AI 연결됨 · <모델>」로 바뀐다. 확인: GET /api/health 의 ai 가 true
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_STT_MODEL=

# 로그인·역할 — 과제가 요구할 때만 AUTH_ON=1. 꺼져 있으면 로그인 화면 없이 기본 역할(AUTH_DEFAULT_ROLE)로 동작한다.
# AUTH_USERS = "id:비밀번호:역할:표시이름;…"  역할 이름은 자유(권장 user=보기 · operator=쓰기). 비밀번호는 여기(.env)에만.
AUTH_ON=0
AUTH_USERS=operator:change-me-1:operator:운영자;user:change-me-2:user:사용자
AUTH_WRITE_ROLES=operator
AUTH_DEFAULT_ROLE=operator
# 빠른 로그인(QA·시연용): 1 이면 로그인 화면 아래에 계정별 「○○로 로그인」 버튼이 뜬다 — 비밀번호 없이 그 계정으로 들어간다. 실제 운영 배포라면 0.
AUTH_QUICK=1
